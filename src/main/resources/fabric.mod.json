{
  "schemaVersion": 1,
  "id": "windrose",
  "version": "${version}",
  "name": "WindRose",
  "description": "A clean, customizable HUD with the day, coordinates, direction, totems used and FPS",
  "authors": ["rodrigograc4"],
  "contact": {
    "homepage": "https://github.com/rodrigograc4/WindRose",
    "issues": "https://github.com/rodrigograc4/WindRose/issues",
    "sources": "https://github.com/rodrigograc4/WindRose"
  },
  "license": "MIT",
  "icon": "assets/windrose/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.rodrigograc4.windrose.WindRose"],
    "modmenu": ["com.rodrigograc4.windrose.util.ModMenuIntegration"]
  },
  "mixins": [
    {
      "config": "windrose.mixin.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
